(auth) {
    route /auth* {
        authenticate with {args[0]}
    }
    route {
        authorize with {args[1]}
        {block}
    }
}
(tls) {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
        propagation_timeout 300s
        propagation_delay 30s
    }
    
}